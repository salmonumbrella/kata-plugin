{
  "extends": "./.claude-plugin/types/tsconfig.json",
  "include": [
    "hooks/**/*.ts",
    "types/**/*.d.ts",
    "tests/**/*.test.ts"
  ],
  "exclude": [
    "tests/properties.ts",
    "node_modules"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noUnusedLocals": true
  }
}
