{
  "name": "kata",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:engine && npm run test:properties && npm run test:real-kata",
    "test:properties": "tsx --test tests/properties.ts",
    "typecheck": "tsc -p .",
    "validate": "claude plugin validate .",
    "test:real-kata": "node --test tests/real-kata.test.mjs",
    "test:engine": "node --test tests/run-engine.test.mjs && node tests/run-engine.mjs"
  },
  "devDependencies": {
    "fast-check": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "esbuild": "^0.28.2"
  }
}
